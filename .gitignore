StorixApp/dist/
StorixApp/dist-ssr/
StorixApp/.vite/
StorixApp/.cache/

############################
# Backend (.NET)
############################

StorixBackend/bin/
StorixBackend/obj/
StorixBackend/.vs/

############################
# Visual Studio
############################

.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

############################
# VS Code
############################

.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

############################
# JetBrains Rider
############################

.idea/

############################
# Logs
############################

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

############################
# Environment Variables
############################

.env
.env.*
!.env.example

############################
# Operating System
############################

.DS_Store
Thumbs.db
Desktop.ini

############################
